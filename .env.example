# Exciting AI — Example Environment Configuration
# Copy this file to .env for local overrides. NEVER commit .env with real secrets!

# Application Server Port
PORT=2020

# Application Environment (development | production)
NODE_ENV=production

# Optional: Custom Web Search API Endpoint (defaults to public multi-engine search)
# WEB_SEARCH_ENDPOINT=https://api.search.example.com
# WEB_SEARCH_API_KEY=your_optional_key_here

# Optional: Provider Custom API Overrides (defaults to built-in free tier)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
